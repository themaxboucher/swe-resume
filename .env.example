# Postgres (Neon in production: use the pooled connection string)
DATABASE_URL=postgres://user:password@localhost:5432/swe_resume

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth providers (buttons only appear when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email via Resend. Without a key, links are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Résumé <hello@yourdomain.com>"
